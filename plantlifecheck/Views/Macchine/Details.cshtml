@model plantlifecheck.Models.Macchina

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Macchina</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Decrizione)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Decrizione)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UltimaModifica)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UltimaModifica)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utente)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utente.Email)
        </dd>
    </dl>
</div>
<div>
    @if (ReadWrite.isEnable(Model.Nome.Name, User))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    }
    <a asp-action="Index" asp-route-id_impianto="@Model.Impianto.Id">Back to List</a>
</div>
