@model plantlifecheck.Models.Macchina

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var id_impianto = ViewBag.id_impianto;
}

<h1>Create</h1>

<h4>Macchina</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input type="hidden" name="id_impianto" value="@id_impianto" class="form-control" />
                <label for="name" class="control-label">Nome:</label>
                <input name="name" class="form-control" />
                <label asp-for="Decrizione" class="control-label"></label>
                <input asp-for="Decrizione" class="form-control" />
                <span asp-validation-for="Decrizione" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-route-id_impianto="@id_impianto">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
